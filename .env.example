# Copy to .env for local development:  cp .env.example .env
# The Flask CLI loads .env automatically (python-dotenv). Never commit .env.

# Which config class to use: development | testing | production
APP_ENV=development
FLASK_APP=wsgi.py

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Defaults to SQLite at instance/sentinelops.db when unset.
# Docker/Kubernetes (Phase 2+): postgresql://sentinel:<password>@db:5432/sentinelops
DATABASE_URL=

# Upload limits
MAX_UPLOAD_MB=5
MAX_CSV_ROWS=20000

# ML model
MODEL_PATH=models/model.joblib
# Train an in-memory stub model if MODEL_PATH is missing (never enable in production)
MODEL_FALLBACK_STUB=true

# REST API bearer-token lifetime (seconds)
API_TOKEN_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO

# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false

# prometheus-flask-exporter hides /metrics when Flask debug mode is on unless this is set
DEBUG_METRICS=1

# ---------------------------------------------------------------------------
# Docker Compose (docker compose up). Compose reads this same .env file.
# Use letters and digits only in the password (it is embedded in a URL).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_DB=sentinelops
# Host port for the app: http://localhost:8000
APP_PORT=8000
# Image name/tag used by compose (Jenkins pushes <dockerhub-user>/sentinelops:<git-sha>)
IMAGE_REPO=sentinelops
IMAGE_TAG=local
