# Copy to jenkins/.env (git-ignored) and fill in. Never commit real values.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# Optional: enables the "Push image" stage (main/develop branches only).
# Create a token at https://hub.docker.com -> Account settings -> Personal access tokens
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

REPO_URL=https://github.com/2301730334/sentinelops.git
